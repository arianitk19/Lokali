{
  "name": "lokali",
  "version": "1.0.0",
  "description": "Lokali: sistem porosish për gastronomi (HTML + Tailwind CSS + vanilla JS + Supabase/PostgreSQL)",
  "private": true,
  "scripts": {
    "build": "tailwindcss -i ./src/tailwind.css -o ./assets/css/tailwind.css --minify",
    "watch": "tailwindcss -i ./src/tailwind.css -o ./assets/css/tailwind.css --watch",
    "start": "npx --yes serve -l 3000 ."
  },
  "devDependencies": {
    "tailwindcss": "3.4.17"
  }
}
